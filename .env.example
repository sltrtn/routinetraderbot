# Copy to .env and fill in real values.
# Never commit .env to git.

# Gemini (Google AI Studio)
GEMINI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
TZ=Asia/Kolkata
DATA_DIR=./data
LOG_LEVEL=INFO

# Market windows (IST, 24h format)
PRE_MARKET_START=07:30
PRE_MARKET_END=08:30
INTRADAY_START=09:15
INTRADAY_END=15:30
POST_MARKET_START=18:00
POST_MARKET_END=20:00

# Polling intervals (seconds)
INTRADAY_POLL_INTERVAL=90
SOURCE_HEALTH_INTERVAL=300

# Alert thresholds
MIN_AVG_VOLUME_LAKHS=10
IPO_QIB_THRESHOLD=5.0
IPO_GMP_PCT_THRESHOLD=20.0
